-- ---------- fechar o hub por completo ----------
-- Desliga tudo, devolve o que foi alterado (anti lag, esticar tela), apaga os
-- desenhos e a janela. Depois disso o hub some até você executar o script de novo.
local function fecharHub()
    if hubFechado then return end
    hubFechado = true

    Config.Ligado = false
    Config.Chams = false
    Config.BarraVida = false
    Config.Esp = false
    Config.Esticar = false
    Config.CamFOVAtivo = false
    Config.Shader = false
    removerShader()
    restaurarCeu()
    pcall(function() miraGui:Destroy() end)
    if camFovOriginal then
        pcall(function() Workspace.CurrentCamera.FieldOfView = camFovOriginal end)
        camFovOriginal = nil
    end

    for _, nome in ipairs({ "AimLockTronco", "VidaTomajack", "EspTomajack", "EsticarTomajack", "CamFovTomajack" }) do
        pcall(function() RunService:UnbindFromRenderStep(nome) end)
    end

    for _, c in ipairs(Conex) do
        pcall(function() c:Disconnect() end)
    end

    -- devolve o que o anti lag mudou
    pcall(antiLagEfeitos, false)
    pcall(antiLagTexturas, false)
    pcall(antiLagParticulas, false)
    pcall(antiLagSombras, false)
    pcall(antiLagQualidade, false)

    -- apaga desenhos
    if circulo then pcall(function() circulo:Remove() end) end
    for _, info in pairs(infos) do
        for _, k in ipairs({ "barraBorda", "barraVida" }) do
            if info[k] then pcall(function() info[k]:Remove() end) end
        end
        if info.esp then
            for _, d in pairs(info.esp) do
                pcall(function() d:Remove() end)
            end
        end
    end

    for p in pairs(chams) do
        removerChams(p)
    end
    pcall(function() chamsPasta:Destroy() end)
    pcall(function() gui:Destroy() end)

    if env.TomajackFechar == fecharHub then
        env.TomajackFechar = nil
    end
end

