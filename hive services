local function getInfo(p)
    local char = p.Character
    if not char then
        return nil
    end

    local info = infos[p]
    if not info then
        info = { proxCheck = 0 }
        infos[p] = info
    end

    if info.char ~= char then
        info.char = char
        info.hum = nil
        info.cabeca = nil
        info.tronco = nil
        info.pctInt = nil
        info.proxCheck = 0
    end

    local invalido = not info.tronco or not info.cabeca
        or not info.tronco.Parent or not info.cabeca.Parent
    if invalido and os.clock() >= info.proxCheck then
        info.proxCheck = os.clock() + 0.5
        info.hum = char:FindFirstChildOfClass("Humanoid")
        info.tronco = char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("HumanoidRootPart")
            or char.PrimaryPart
            or char:FindFirstChildWhichIsA("BasePart")
        -- personagens custom de RP: se não tiver "Head", mira no tronco
        info.cabeca = char:FindFirstChild("Head") or info.tronco
    end

    return info
end

-- ================= RAYCAST (reutilizado) =================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Vê se há parede entre a câmera e a parte. Partes transparentes ou sem colisão
-- (vidro, grades, efeitos, hitboxes invisíveis) são ignoradas, porque de longe
-- elas costumavam bloquear o aimlock sem ser uma parede de verdade.
local function modeloDoAssento(char)
    -- carro/moto em que a pessoa está sentada (não deve contar como parede)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local assento = hum and hum.SeatPart
    if not assento then return nil end
    return assento:FindFirstAncestorOfClass("Model") or assento
end

local function raioLivre(origem, destino, char, filtroBase)
    local filtro = table.clone(filtroBase)
    local direcao = destino - origem
    for _ = 1, 6 do
        rayParams.FilterDescendantsInstances = filtro
        local r = Workspace:Raycast(origem, direcao, rayParams)
        if not r then return true end

        local alvo = r.Instance
        if alvo:IsDescendantOf(char) then return true end

        local pai = alvo.Parent
        local ehPessoa = pai and (pai:FindFirstChildOfClass("Humanoid")
            or (pai.Parent and pai.Parent:FindFirstChildOfClass("Humanoid")))
        if ehPessoa or alvo.Transparency >= 0.9 or not alvo.CanCollide then
            filtro[#filtro + 1] = alvo -- não é parede: ignora e continua
        else
            return false
        end
    end
    return false
end

-- Vê se há parede entre a câmera e o alvo. Testa a parte mirada e também cabeça e
-- corpo: se qualquer um aparecer, o alvo conta como visível (evita falhar quando só
-- um pedaço está atrás de algo, ou quando a pessoa está dentro de um carro).
local function temVisao(parte, char)
    if not Config.WallCheck then return true end

    local origem = camera.CFrame.Position
    if (parte.Position - origem).Magnitude > Config.WallCheckMax then return true end
    local filtroBase = {}
    if player.Character then filtroBase[#filtroBase + 1] = player.Character end
    local meuCarro = modeloDoAssento(player.Character)
    if meuCarro then filtroBase[#filtroBase + 1] = meuCarro end
    local carroDele = modeloDoAssento(char)
    if carroDele then filtroBase[#filtroBase + 1] = carroDele end

    if raioLivre(origem, parte.Position, char, filtroBase) then return true end

    local cabeca = char:FindFirstChild("Head")
    if cabeca and cabeca ~= parte and raioLivre(origem, cabeca.Position, char, filtroBase) then
        return true
    end
    local raiz = char:FindFirstChild("HumanoidRootPart")
    if raiz and raiz ~= parte and raioLivre(origem, raiz.Position, char, filtroBase) then
        return true
    end
    return false
end

-- ================= AIM LOCK =================
local bloqueados = {}

-- ---- jogadores que o aimlock nunca deve travar (amigos / lista de nicks) ----
local listaIgnorar = {}   -- [nick em minúsculo] = true
local cacheAmigo = {}     -- [player] = true/false (consulta ao Roblox é lenta, então guarda)

local function ignorado(outro)
    if listaIgnorar[string.lower(outro.Name)] or listaIgnorar[string.lower(outro.DisplayName)] then
        return true
    end
    if Config.IgnorarAmigos then
        local c = cacheAmigo[outro]
        if c == nil then
            cacheAmigo[outro] = false -- evita consultar de novo enquanto espera
            task.spawn(function()
                local ok, res = pcall(function() return player:IsFriendsWith(outro.UserId) end)
                cacheAmigo[outro] = ok and res or false
            end)
            return false
        end
        return c
    end
    return false
end

local function acharAlvo()
    local centro = UserInputService:GetMouseLocation()
    local camPos = camera.CFrame.Position
    table.clear(bloqueados)

    for _ = 1, 4 do
        local melhorParte, melhorChar
        local melhorNota = 1 -- nota = distância até a mira / FOV permitido (menor é melhor, 1 = borda)

        for _, outro in ipairs(jogadores) do
            local info = getInfo(outro)
            -- parte que vai ser mirada: cabeça ou tronco
            local parte = info and ((Config.AlvoParte == "Cabeça" and info.cabeca) or info.tronco)
            if info and parte and parte.Parent
                and (not info.hum or info.hum.Health > 0)
                and not bloqueados[parte]
                and not ignorado(outro)
                and not (Config.TeamCheck and outro.Team ~= nil and outro.Team == player.Team)
            then
                local distMundo = (parte.Position - camPos).Magnitude
                if distMundo <= Config.AlcanceMax then
                    local pos, naTela = camera:WorldToViewportPoint(parte.Position)
                    if naTela and pos.Z > 0 then
                        -- quem está longe fica pequeno na tela: aceita um FOV até 2x maior
                        local limite = Config.FOV
                        if Config.FOVDinamico then
                            limite = limite * (1 + math.min(distMundo / 150, 5)) -- até 6x maior para quem está bem longe
                        end

                        local dx, dy = pos.X - centro.X, pos.Y - centro.Y
                        local nota = math.sqrt(dx * dx + dy * dy) / limite
                        if nota < melhorNota then
                            melhorNota = nota
                            melhorParte = parte
                            melhorChar = info.char
                        end
                    end
                end
            end
        end

        if not melhorParte then
            return nil
        end
        if temVisao(melhorParte, melhorChar) then
            return melhorParte
        end
        bloqueados[melhorParte] = true
    end

    return nil
end

