-- ================= BARRA DE VIDA EM CIMA DO NOME =================
local function novoQuadrado()
    local q = Drawing.new("Square")
    q.Filled = true
    q.Thickness = 1
    q.Transparency = 1
    q.Visible = false
    return q
end

local function esconderBarra(info)
    if info.barraVisivel then
        info.barraBorda.Visible = false
        info.barraVida.Visible = false
        info.barraVisivel = false
    end
end

local function paraTela(posicao)
    local ponto = camera:WorldToViewportPoint(posicao)
    if ponto.Z <= 0 then
        return nil
    end
    return Vector2.new(ponto.X, ponto.Y)
end

local function desenharBarra(outro, camPos)
    local info = getInfo(outro)
    if not info then
        local antigo = infos[outro]
        if antigo then esconderBarra(antigo) end
        return
    end

    local hum, cabeca, tronco = info.hum, info.cabeca, info.tronco
    if not (hum and cabeca and tronco and cabeca.Parent and tronco.Parent)
        or hum.Health <= 0
        or (Config.ChamsIgnorarTime and outro.Team ~= nil and outro.Team == player.Team)
        or (tronco.Position - camPos).Magnitude > Config.EspDistancia
    then
        esconderBarra(info)
        return
    end

    local topo = cabeca.Position + Vector3.new(0, Config.AlturaBarra, 0)
    local p1 = paraTela(topo)
    local p2 = paraTela(topo - Vector3.new(0, 1, 0))
    if not p1 or not p2 then
        esconderBarra(info)
        return
    end

    if not info.barraBorda then
        info.barraBorda = novoQuadrado()
        info.barraBorda.Color = Color3.fromRGB(0, 0, 0)
        info.barraBorda.Transparency = 0.6
        info.barraVida = novoQuadrado()
    end

    local pixelsPorStud = math.abs(p2.Y - p1.Y)
    local largura = math.clamp(pixelsPorStud * 3, 24, 120)
    local altura = math.clamp(pixelsPorStud * 0.35, 3, 8)
    local x = p1.X - largura / 2
    local y = p1.Y - altura / 2

    local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)

    info.barraBorda.Position = Vector2.new(x - 1, y - 1)
    info.barraBorda.Size = Vector2.new(largura + 2, altura + 2)

    info.barraVida.Position = Vector2.new(x, y)
    info.barraVida.Size = Vector2.new(largura * pct, altura)
    if info.ultimoPct ~= pct then
        info.ultimoPct = pct
        info.barraVida.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), pct)
    end

    info.barraBorda.Visible = true
    info.barraVida.Visible = true
    info.barraVisivel = true
end

local barraEstavaLigada = false

RunService:BindToRenderStep("VidaTomajack", PRIORIDADE_VIDA, function()
    if not temDrawing then return end

    if not Config.BarraVida then
        if barraEstavaLigada then
            for _, info in pairs(infos) do
                esconderBarra(info)
            end
            barraEstavaLigada = false
        end
        return
    end
    barraEstavaLigada = true

    camera = Workspace.CurrentCamera
    local camPos = camera.CFrame.Position

    for _, outro in ipairs(jogadores) do
        local ok = pcall(desenharBarra, outro, camPos)
        if not ok then
            local info = infos[outro]
            if info then pcall(esconderBarra, info) end
        end
    end
end)

-- ================= ESP (CAIXA, NOME, VIDA E DISTÂNCIA) =================
local PRETO = Color3.fromRGB(0, 0, 0)

local function novoTextoEsp(tamanho)
    local t = Drawing.new("Text")
    t.Size = tamanho
    t.Center = true
    t.Outline = true
    t.Transparency = 1
    t.Visible = false
    return t
end

local function novoQuadradoEsp(preenchido, espessura, cor)
    local q = Drawing.new("Square")
    q.Filled = preenchido
    q.Thickness = espessura
    q.Color = cor
    q.Transparency = 1
    q.Visible = false
    return q
end

local function criarEsp(info)
    info.esp = {
        sombra = novoQuadradoEsp(false, 3, PRETO),
        caixa = novoQuadradoEsp(false, 1, Color3.new(1, 1, 1)),
        nome = novoTextoEsp(14),
        dist = novoTextoEsp(13),
        vidaFundo = novoQuadradoEsp(true, 1, PRETO),
        vidaBarra = novoQuadradoEsp(true, 1, Color3.new(0, 1, 0)),
        vidaTexto = novoTextoEsp(12),
    }
    return info.esp
end

local function esconderEsp(info)
    if info.esp and info.espVisivel then
        for _, d in pairs(info.esp) do
            d.Visible = false
        end
        info.espVisivel = false
    end
end

local function desenharEsp(outro, camPos)
    local info = getInfo(outro)
    if not info then
        local antigo = infos[outro]
        if antigo then esconderEsp(antigo) end
        return
    end

    local hum, cabeca, tronco = info.hum, info.cabeca, info.tronco
    if not (hum and cabeca and tronco and cabeca.Parent and tronco.Parent)
        or hum.Health <= 0
        or (Config.EspSoInimigos and outro.Team ~= nil and outro.Team == player.Team)
        or (tronco.Position - camPos).Magnitude > Config.EspDistancia
    then
        esconderEsp(info)
        return
    end

    local raiz = info.raiz
    if not raiz or not raiz.Parent or info.raizChar ~= info.char then
        raiz = info.char:FindFirstChild("HumanoidRootPart") or tronco
        info.raiz = raiz
        info.raizChar = info.char
    end

    local topo = paraTela(cabeca.Position + Vector3.new(0, cabeca.Size.Y / 2 + 0.2, 0))
    local base = paraTela(raiz.Position - Vector3.new(0, 3, 0))
    if not topo or not base or base.Y - topo.Y < 4 then
        esconderEsp(info)
        return
    end

    local esp = info.esp or criarEsp(info)

    local altura = base.Y - topo.Y
    local largura = altura * 0.6
    local cx = topo.X
    local x, y = cx - largura / 2, topo.Y
    local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
    local corVida = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), pct)

    local mostrarCaixa = Config.EspCaixa
    esp.sombra.Visible = mostrarCaixa
    esp.caixa.Visible = mostrarCaixa
    if mostrarCaixa then
        esp.sombra.Position = Vector2.new(x, y)
        esp.sombra.Size = Vector2.new(largura, altura)
        esp.caixa.Position = Vector2.new(x, y)
        esp.caixa.Size = Vector2.new(largura, altura)
        esp.caixa.Color = Config.EspCor
    end

    esp.nome.Visible = Config.EspNome
    if Config.EspNome then
        esp.nome.Text = outro.DisplayName
        esp.nome.Color = Config.EspNomeCor
        esp.nome.Position = Vector2.new(cx, y - 17)
    end

    local mostrarVida = Config.EspVidaLado
    esp.vidaFundo.Visible = mostrarVida
    esp.vidaBarra.Visible = mostrarVida
    esp.vidaTexto.Visible = mostrarVida
    if mostrarVida then
        esp.vidaFundo.Position = Vector2.new(x - 6, y - 1)
        esp.vidaFundo.Size = Vector2.new(4, altura + 2)
        esp.vidaBarra.Position = Vector2.new(x - 5, y + altura * (1 - pct))
        esp.vidaBarra.Size = Vector2.new(2, altura * pct)
        esp.vidaBarra.Color = corVida
        esp.vidaTexto.Text = tostring(math.floor(pct * 100 + 0.5))
        esp.vidaTexto.Color = corVida
        esp.vidaTexto.Position = Vector2.new(x - 15, y - 7)
    end

    esp.dist.Visible = Config.EspDistTexto
    if Config.EspDistTexto then
        esp.dist.Text = math.floor((raiz.Position - camPos).Magnitude) .. "m"
        esp.dist.Color = Color3.new(1, 1, 1)
        esp.dist.Position = Vector2.new(cx, base.Y + 2)
    end

    info.espVisivel = true
end

