    aba.botao, aba.marca, aba.rotulo, aba.pagina = botao, marca, rotuloAba, pagina

    local function selecionar()
        if abaAtiva == aba then return end
        if abaAtiva then
            abaAtiva.pagina.Visible = false
            tw(abaAtiva.marca, 0.2, { BackgroundTransparency = 1 })
