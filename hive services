-- ---------- MIRA NA TELA (crosshair) ----------
-- Desenha o crosshair com formas (sem precisar de imagem) e mostra o "ID" de cada modelo.
local function formaMira(pai, id, cor)
    local function barra(x, y, w, h, rot)
        return criar("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, x, 0.5, y),
            Size = UDim2.fromOffset(w, h),
            BackgroundColor3 = cor,
            BorderSizePixel = 0,
            Rotation = rot or 0,
        }, pai)
    end
    local function ponto(tam)
        local f = barra(0, 0, tam, tam)
        cantos(f, 100)
        return f
    end
    local function anel(tam, grosso, quadrado)
        local f = criar("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(tam, tam),
            BackgroundTransparency = 1,
        }, pai)
        criar("UIStroke", { Color = cor, Thickness = grosso }, f)
        if not quadrado then
            criar("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
        end
        return f
    end

    if id == 1 then
        ponto(5)
    elseif id == 2 then
        barra(0, -9, 2, 8) barra(0, 9, 2, 8) barra(-9, 0, 8, 2) barra(9, 0, 8, 2)
    elseif id == 3 then
        barra(0, -13, 1, 12) barra(0, 13, 1, 12) barra(-13, 0, 12, 1) barra(13, 0, 12, 1)
    elseif id == 4 then
        anel(22, 2)
    elseif id == 5 then
        anel(22, 1.5) ponto(3)
    elseif id == 6 then
        barra(0, 0, 2, 26, 45) barra(0, 0, 2, 26, -45)
    elseif id == 7 then
        barra(-9, 0, 8, 2) barra(9, 0, 8, 2) barra(0, 9, 2, 8)
    elseif id == 8 then
        barra(-5, 2, 14, 2, -35) barra(5, 2, 14, 2, 35)
    elseif id == 9 then
        anel(20, 1.5, true)
    elseif id == 10 then
        barra(0, -9, 2, 8) barra(0, 9, 2, 8) barra(-9, 0, 8, 2) barra(9, 0, 8, 2) ponto(3)
    elseif id == 11 then
        anel(16, 1.5, true).Rotation = 45
    else
        anel(28, 1) barra(0, -7, 2, 6) barra(0, 7, 2, 6) barra(-7, 0, 6, 2) barra(7, 0, 6, 2)
    end
end
