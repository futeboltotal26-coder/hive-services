        if info.barraBorda then pcall(function() info.barraBorda:Remove() end) end
        if info.barraVida then pcall(function() info.barraVida:Remove() end) end
        if info.esp then
            for _, d in pairs(info.esp) do
                pcall(function() d:Remove() end)
            end
        end
    end
    infos[p] = nil
    task.defer(atualizarLista)
end)

local chamsEstavaLigado = false
task.spawn(function()
    while not hubFechado do
        if Config.Chams then
            chamsEstavaLigado = true
            for _, outro in ipairs(jogadores) do
