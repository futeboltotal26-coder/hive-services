-- ================= SHADER (REALISTA) =================
-- Só usa efeitos de pós-processamento do próprio Roblox (baratos). Três níveis:
--   1 leve      : cor e brilho discretos
--   2 realista  : + profundidade de campo suave, raios de sol, névoa leve e reflexos
--   3 ultra     : visual cinematográfico, o mais bonito (e o mais pesado dos três)
-- Tudo é removido e a iluminação volta ao normal ao desligar.
-- (O "Future lighting" do Roblox não dá para ligar por script: é uma configuração do jogo.)
local PRESETS = {
    [1] = {
        contraste = 0.08, saturacao = 0.10, brilho = 0,
        bloom = 0.15, bloomTam = 24, bloomLimite = 0.97,
        sol = 0.04, nevoa = 0.10, haze = 0.10,
        exposicao = 0, dof = nil, reflexo = nil, sombra = 0.25,
    },
    [2] = {
        contraste = 0.14, saturacao = 0.18, brilho = 0,
        bloom = 0.25, bloomTam = 26, bloomLimite = 0.95,
        sol = 0.08, nevoa = 0.16, haze = 0.15,
        exposicao = -0.05, dof = { longe = 0.10, foco = 160, raio = 100 }, reflexo = 1, sombra = 0.2,
    },
    [3] = {
        contraste = 0.20, saturacao = 0.26, brilho = -0.01,
        bloom = 0.35, bloomTam = 32, bloomLimite = 0.92,
        sol = 0.12, nevoa = 0.22, haze = 0.25,
        exposicao = -0.08, dof = { longe = 0.22, foco = 120, raio = 70 }, reflexo = 1, sombra = 0.12,
    },
}

local shader = { efeitos = nil, original = nil, atmosfera = nil }

local function removerShader()
    if shader.efeitos then
        for _, e in pairs(shader.efeitos) do
            pcall(function() e:Destroy() end)
        end
        shader.efeitos = nil
    end
    if shader.atmosfera then
        pcall(function() shader.atmosfera:Destroy() end)
        shader.atmosfera = nil
    end
    if shader.original then
        for k, v in pairs(shader.original) do
            pcall(function() Lighting[k] = v end)
        end
        shader.original = nil
    end
end

local function aplicarShader()
    local preset = PRESETS[math.clamp(math.floor(Config.ShaderNivel + 0.5), 1, 3)]
    local i = Config.ShaderIntensidade

    if not shader.efeitos then
        -- guarda o que vamos mexer na iluminação para devolver depois
        shader.original = {}
        for _, k in ipairs({ "ExposureCompensation", "ShadowSoftness", "EnvironmentSpecularScale", "EnvironmentDiffuseScale" }) do
            pcall(function() shader.original[k] = Lighting[k] end)
        end

        local function novo(classe, nome)
            local e = Instance.new(classe)
            e.Name = nome
            e.Parent = Lighting
            return e
        end

        shader.efeitos = {
            cor = novo("ColorCorrectionEffect", "TomajackShaderCor"),
            brilho = novo("BloomEffect", "TomajackShaderBrilho"),
            sol = novo("SunRaysEffect", "TomajackShaderSol"),
            dof = novo("DepthOfFieldEffect", "TomajackShaderProfundidade"),
        }

        -- névoa leve: só se o jogo ainda não tiver uma (para não empilhar)
        if not Lighting:FindFirstChildOfClass("Atmosphere") then
            local atm = Instance.new("Atmosphere")
            atm.Name = "TomajackShaderNevoa"
            atm.Parent = Lighting
            shader.atmosfera = atm
        end
    end

    local e = shader.efeitos

    -- cor: contraste, saturação e um tom levemente quente
    e.cor.Contrast = preset.contraste * i
    e.cor.Saturation = preset.saturacao * i
    e.cor.Brightness = preset.brilho * i
    e.cor.TintColor = Color3.fromRGB(250, 245, 240)

    -- brilho suave nas partes claras
    e.brilho.Intensity = preset.bloom * i
    e.brilho.Size = preset.bloomTam
    e.brilho.Threshold = preset.bloomLimite

    -- raios de sol
    e.sol.Intensity = preset.sol * i
    e.sol.Spread = 0.75

    -- profundidade de campo: desfoca só o que está bem longe (nível 2 e 3)
    if preset.dof then
        e.dof.Enabled = true
        e.dof.FarIntensity = math.min(preset.dof.longe * i, 0.6)
        e.dof.FocusDistance = preset.dof.foco
        e.dof.InFocusRadius = preset.dof.raio
        e.dof.NearIntensity = 0
    else
        e.dof.Enabled = false
    end

    -- névoa atmosférica
    if shader.atmosfera then
        local a = shader.atmosfera
        a.Density = preset.nevoa * math.min(i, 1.3)
        a.Offset = 0.2
        a.Color = Color3.fromRGB(165, 175, 192)
        a.Decay = Color3.fromRGB(88, 94, 106)
        a.Glare = 0
        a.Haze = preset.haze * math.min(i, 1.3)
    end

    -- iluminação: exposição, sombras suaves e reflexos
    if shader.original then
        pcall(function()
            Lighting.ExposureCompensation = (shader.original.ExposureCompensation or 0) + preset.exposicao * i
            Lighting.ShadowSoftness = preset.sombra
            -- só os reflexos (a luz geral não muda, para não esbranquiçar)
            if preset.reflexo then
                Lighting.EnvironmentSpecularScale = preset.reflexo
            else
                Lighting.EnvironmentSpecularScale = shader.original.EnvironmentSpecularScale or 1
            end
        end)
    end
end

