    local item = criar("Frame", {
        Size = UDim2.fromOffset(250, 52),
        BackgroundColor3 = T.Painel,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, notifFrame)
    cantos(item, 8)
    local s = borda(item, T.Ciano, 1, 1)
    local barra = criar("Frame", {
        Size = UDim2.new(0, 3, 1, -12),
        Position = UDim2.fromOffset(6, 6),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, item)
    cantos(barra, 2)
    neon(barra, 90)
    local l1 = texto(item, {
        Position = UDim2.fromOffset(18, 6), Size = UDim2.new(1, -26, 0, 18),
        Text = tituloTxt, Font = Enum.Font.GothamBold, TextSize = 13, TextTransparency = 1,
    })
    local l2 = texto(item, {
        Position = UDim2.fromOffset(18, 26), Size = UDim2.new(1, -26, 0, 18),
        Text = corpo, TextSize = 12, TextColor3 = T.Dim, TextTransparency = 1,
    })
    tw(item, 0.25, { BackgroundTransparency = 0.05 })
    tw(s, 0.25, { Transparency = 0.5 })
    tw(barra, 0.25, { BackgroundTransparency = 0 })
    tw(l1, 0.25, { TextTransparency = 0 })
    tw(l2, 0.25, { TextTransparency = 0 })

    task.delay(duracao or 3, function()
        tw(item, 0.3, { BackgroundTransparency = 1 })
        tw(s, 0.3, { Transparency = 1 })
        tw(barra, 0.3, { BackgroundTransparency = 1 })
        tw(l1, 0.3, { TextTransparency = 1 })
        tw(l2, 0.3, { TextTransparency = 1 })
        task.wait(0.35)
        item:Destroy()
    end)
